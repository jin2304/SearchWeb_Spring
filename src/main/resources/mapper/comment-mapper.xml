<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- Comment Mapper (Legacy - PostgreSQL) -->
<mapper namespace="com.web.SearchWeb.comment.dao.CommentDao">

    <!-- ResultMap for Comment entity -->
    <resultMap id="CommentResultMap" type="com.web.SearchWeb.comment.domain.Comment">
        <id property="commentId" column="comment_id"/>
        <result property="boardBoardId" column="board_board_id"/>
        <result property="memberMemberId" column="member_member_id"/>
        <result property="memberNickname" column="member_nickname"/>
        <result property="memberJob" column="member_job"/>
        <result property="memberMajor" column="member_major"/>
        <result property="content" column="content"/>
        <result property="createdDate" column="created_date"/>
    </resultMap>


    <!-- 게시글 댓글 생성 -->
    <insert id="insertComment" parameterType="com.web.SearchWeb.comment.domain.Comment">
        INSERT INTO comment (board_board_id, member_member_id, member_nickname, member_job, member_major, content)
        VALUES (#{boardBoardId}, #{memberMemberId}, #{memberNickname}, #{memberJob}, #{memberMajor}, #{content})
    </insert>


    <!-- 게시글 댓글 목록 조회 -->
    <select id="selectComments" resultMap="CommentResultMap">
        SELECT *
        FROM comment
        WHERE board_board_id = #{boardId}
    </select>


    <!-- 회원번호로 게시글 댓글 목록 조회 -->
    <select id="selectCommentsByMemberId" resultMap="CommentResultMap">
        SELECT *
        FROM comment
        WHERE member_member_id = #{memberId}
    </select>


    <!-- 게시글 댓글 단일 조회 -->
    <select id="selectComment" resultMap="CommentResultMap">
        SELECT *
        FROM comment
        WHERE comment_id = #{commentId}
    </select>


    <!-- 게시글 댓글 수정 -->
    <update id="updateComment" parameterType="com.web.SearchWeb.comment.domain.Comment">
        UPDATE comment
        SET content = #{commentDto.content}
        WHERE comment_id = #{commentId}
    </update>


    <!-- 게시글 댓글 사용자 프로필 수정 -->
    <update id="updateCommentUserProfile" parameterType="com.web.SearchWeb.comment.dto.UpdateUserProfileCommentDto">
        UPDATE comment
        SET
            member_nickname = #{nickname},
            member_job = #{job},
            member_major = #{major}
        WHERE comment_id = #{commentId}
    </update>


    <!-- 게시글 댓글 삭제 -->
    <delete id="deleteComment">
        DELETE FROM comment
        WHERE comment_id = #{commentId}
    </delete>


    <!-- 게시글 댓글 수 조회 -->
    <select id="countComments" resultType="int">
        SELECT COUNT(*) FROM comment
        WHERE board_board_id = #{boardId}
    </select>

</mapper>