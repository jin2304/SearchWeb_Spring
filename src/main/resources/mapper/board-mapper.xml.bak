<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

    <!~~ Board Mapper ~~>
<mapper namespace="com.web.SearchWeb.board.dao.BoardDao">

    <!~~ ResultMap for Board entity ~~>
    <resultMap id="BoardResultMap" type="com.web.SearchWeb.board.domain.Board">
        <id property="boardId" column="board_id"/>
        <result property="memberMemberId" column="member_member_id"/>
        <result property="nickname" column="nickname"/>
        <result property="job" column="job"/>
        <result property="major" column="major"/>
        <result property="url" column="url"/>
        <result property="title" column="title"/>
        <result property="summary" column="summary"/>
        <result property="description" column="description"/>
        <result property="hashtags" column="hashtags"/>
        <result property="likesCount" column="likes_count"/>
        <result property="commentsCount" column="comments_count"/>
        <result property="bookmarksCount" column="bookmarks_count"/>
        <result property="viewsCount" column="views_count"/>
        <result property="createdDate" column="created_date"/>
    </resultMap>


    <!~~ 게시글 생성 ~~>
    <insert id="insertBoard" parameterType="map">
        INSERT INTO board (member_member_id, url, title, summary, description, hashtags)
        VALUES (#{memberId}, #{boardDto.url}, #{boardDto.title}, #{boardDto.summary}, #{boardDto.description}, #{boardDto.hashtags})
    </insert>


    <!~~ 페이징된 게시글 목록 조회 ~~>
    <select id="selectBoardPage" parameterType="map" resultMap="BoardResultMap">
        SELECT
            b.board_id,
            b.title,
            b.description,
            b.created_date,
            b.url,
            b.member_member_id,
            m.nick_name AS nickname,
            m.job,
            m.major
        FROM board b
        JOIN member m ON b.member_member_id = m.member_id
        <where>
            <!~~ 검색어가 있는 경우 ~~>
            <if test="query != null and query != ''">
                (title LIKE '%' || #{query} || '%'
                OR
                description LIKE '%' || #{query} || '%')
            </if>

            <!~~ 게시글 타입 선택 ~~>
            <!~~ url이 존재하는 경우 == 웹사이트 공유 게시글~~>
            <if test="postType == 'website'">
                AND url IS NOT NULL
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="sort == 'Newest'">created_date DESC</when>
            <when test="sort == 'Popular'">likes_count DESC</when>
            <otherwise>created_date DESC</otherwise>
        </choose>
        LIMIT #{limit} OFFSET #{offset}
    </select>


    <!~~ 전체 게시글 수 조회 ~~>
    <select id="selectBoardCount" resultType="int">
        SELECT COUNT(*) FROM board
        <where>
            <if test="query != null and query != ''">
                (title LIKE '%' || #{query} || '%'
                OR description LIKE '%' || #{query} || '%')
            </if>
            <if test="postType == 'website'">
                AND url IS NOT NULL
            </if>
            <if test="postType == 'question'">
                AND url IS NULL
            </if>
        </where>
    </select>


    <!~~ 게시글 조회(회원번호로 조회) ~~>
    <select id="selectBoardListByMemberId" resultMap="BoardResultMap">
        SELECT * FROM board
        WHERE member_member_id = #{memberId}
    </select>


    <!~~ 게시글 단일 조회 ~~>
    <select id="selectBoard" resultMap="BoardResultMap">
        SELECT * FROM board
        WHERE board_id = #{boardId}
    </select>


    <!~~ 게시글 수정 ~~>
    <update id="updateBoard" parameterType="Map">
        UPDATE board
        SET
            url = #{boardDto.url},
            title = #{boardDto.title},
            summary = #{boardDto.summary},
            description = #{boardDto.description},
            hashtags = #{boardDto.hashtags}
        WHERE board_id = #{boardId}
    </update>


    <!~~ 게시글 프로필 수정 ~~>
    <update id="updateBoardProfile" parameterType="Map">
        UPDATE board
        SET
            job = #{job},
            major = #{major}
        WHERE board_id = #{boardId}
    </update>



    <!~~ 게시글 삭제 ~~>
    <delete id="deleteBoard" parameterType="Map">
        DELETE FROM board
        WHERE board_id = #{boardId}
    </delete>


    <!~~ 게시글 북마크 수 수정 ~~>
    <update id="updateBookmarkCount" parameterType="map">
        UPDATE board
        SET bookmarks_count = #{bookmarkCount}
        WHERE board_id = #{boardId}
    </update>


    <!~~ 게시글 조회수 증가 ~~>
    <update id="incrementViewCount">
        UPDATE board
        SET views_count = views_count + 1
        WHERE board_id = #{boardId}
    </update>


    <!~~ 게시글 좋아요 증가 ~~>
    <update id="incrementLikeCount">
        UPDATE board
        SET likes_count = likes_count + 1
        WHERE board_id = #{boardId}
    </update>


    <!~~ 게시글 좋아요 감소 ~~>
    <update id="decrementLikeCount">
        UPDATE board
        SET likes_count = likes_count - 1
        WHERE board_id = #{boardId}
    </update>


    <update id="incrementCommentCount">
        UPDATE board
        SET comments_count = comments_count + 1
        WHERE board_id = #{boardId}
    </update>


    <!~~ 게시글 댓글 수 감소 ~~>
    <update id="decrementCommentCount">
        UPDATE board
        SET comments_count = comments_count - 1
        WHERE board_id = #{boardId}
    </update>


</mapper>