<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.web.SearchWeb.member.dao.MemberDao">

    <!-- ResultMap for Member entity -->
    <resultMap id="MemberResultMap" type="com.web.SearchWeb.member.domain.Member">
        <id property="memberId" column="member_id"/>
        <result property="email" column="email"/>
        <result property="loginId" column="login_id"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="memberName" column="member_name"/>
        <result property="nickName" column="nick_name"/>
        <result property="job" column="job"/>
        <result property="major" column="major"/>
        <result property="summary" column="summary"/>
        <result property="status" column="status"/>
        <result property="role" column="role"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>
        <result property="createdByMemberId" column="created_by_member_id"/>
        <result property="updatedByMemberId" column="updated_by_member_id"/>
        <result property="deletedByMemberId" column="deleted_by_member_id"/>
    </resultMap>


    <!-- 소셜 회원가입 -->
    <insert id="insertSocialMember" parameterType="com.web.SearchWeb.member.domain.Member" useGeneratedKeys="true" keyProperty="memberId" keyColumn="member_id">
        INSERT INTO member (login_id, password_hash, member_name, nick_name, role, email)
        VALUES (#{loginId}, #{passwordHash}, #{memberName}, #{nickName}, #{role}, #{email})
    </insert>


    <!-- 회원번호로 조회 -->
    <select id="findByMemberId" parameterType="long" resultMap="MemberResultMap">
        SELECT * FROM member
        WHERE member_id = #{memberId}
        AND deleted_at IS NULL
    </select>


    <!-- 로그인 아이디로 조회 -->
    <select id="findByLoginId" parameterType="String" resultMap="MemberResultMap">
        SELECT * FROM member
        WHERE login_id = #{loginId}
        AND deleted_at IS NULL
    </select>


    <!-- 회원 수정 -->
    <update id="updateMember" parameterType="map">
        UPDATE member
        SET
            job = #{memberUpdateDto.job},
            major = #{memberUpdateDto.major},
            summary = #{memberUpdateDto.summary},
            nick_name = #{memberUpdateDto.nickName},
            updated_at = now()
        WHERE member_id = #{memberId}
        AND deleted_at IS NULL
    </update>


    <!-- 소셜 회원 수정 -->
    <update id="updateSocialIdentity" parameterType="map">
        UPDATE member
        SET
            member_name = #{member.memberName},
            email = #{member.email},
            updated_at = now()
        WHERE member_id = #{memberId}
        AND deleted_at IS NULL
    </update>
</mapper>
